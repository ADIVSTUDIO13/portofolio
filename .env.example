# ==========================================
# Konfigurasi Environment Variable Portofolio
# Salin file ini menjadi .env.local atau .env
# ==========================================

# Supabase (Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-migrations

# Groq Cloud AI SDK (Digunakan untuk AI Assistant & Smart OCR Parsing)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Domain & URL Publik
NEXT_PUBLIC_SITE_URL=https://www.myportofolioarya.my.id
